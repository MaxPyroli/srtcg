{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcg-communaute",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // Le site (pages, images) est servi gratuitement depuis le dossier public/.
  // not_found_handling : une adresse comme /admin ou /collection ne correspond à aucun fichier,
  // donc sans ça Cloudflare renvoyait une 404 au lieu de la page (qui gère ces routes elle-même en JS).
  // run_worker_first : /api/* doit toujours passer par le Worker, jamais par ce filet de secours.
  "assets": { "directory": "./public", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcg-communaute",
      // Remplacer par l'identifiant affiché par : npx wrangler d1 create tcg-communaute
      "database_id": "REMPLACER-PAR-L-ID-DE-LA-BASE",
      "migrations_dir": "migrations"
    }
  ],

  // La connexion de test est coupée par défaut. Ne jamais la mettre à "1" en production.
  "vars": { "DEV_AUTH": "0" }
}
