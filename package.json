{
  "name": "tcg-communaute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jeu de cartes à collectionner en ligne pour la communauté : boosters, collection, échanges.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "node --experimental-strip-types scripts/simulate.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
